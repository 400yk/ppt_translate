FLASK_API_URL=http://localhost:5000/api
REDIS_URL=
GEMINI_API_KEY=
# Model name without the "models/" prefix.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional full generateContent URL; overrides BOTH the base URL and model.
# GEMINI_API_URL=https://gateway.example/v1beta/models/your-model:generateContent

# OpenAI-compatible fallback. Key, endpoint, region and model must match.
DASHSCOPE_API_KEY=
# Beijing workspace endpoint: replace YOUR_WORKSPACE_ID with the console value.
DEEPSEEK_API_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DeepSeek served directly by Alibaba Cloud in Beijing.
DEEPSEEK_MODEL=deepseek-v4.1-flash-1017
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

